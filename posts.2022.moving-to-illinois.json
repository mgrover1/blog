{"version":3,"kind":"Article","sha256":"3c520681597fe1157482cf8492478d06c4ac7c9110ba6cd71107a300f55bd5aa","slug":"posts.2022.moving-to-illinois","location":"/posts/2022/moving-to-illinois.md","dependencies":[],"frontmatter":{"title":"Moving to Illinois (Again)","authors":[{"id":"Max Grover","name":"Max Grover"}],"date":"2022-06-06","content_includes_title":false,"github":"https://github.com/mgrover1/blog","numbering":{"title":{"offset":2}},"source_url":"https://github.com/mgrover1/blog/blob/main/posts/2022/moving-to-illinois.md","edit_url":"https://github.com/mgrover1/blog/edit/main/posts/2022/moving-to-illinois.md","thumbnail":"/build/delavan-lake-sunset-06e9f7dab2f78fa8c8eb32d31a11e6e4.png","exports":[{"format":"md","filename":"moving-to-illinois.md","url":"/build/moving-to-illinois-9860224992d04e188cde3904b339c277.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"It has been a while since my last post! Over the past ~9 months, I started a new job at Argonne National Laboratory and relocated to the state of Illinois, more specifically the Western Suburbs of Chicago, Illinois. I work with Scott Collis, a scientist and Geospatial Computing, Innovations, and Sensing (GCIS) Department Head. He is also the inventor of the ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"twBJMopOYx"},{"type":"link","url":"https://arm-doe.github.io/pyart/index.html","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Python Atomspheric Radiation Measurement Toolkit (Py-ART)","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"tXVOG8IEZ7"}],"urlSource":"https://arm-doe.github.io/pyart/index.html","key":"ZAaTenIdCA"},{"type":"text","value":", one of the go-to packages when working with weather radar data in Python.","position":{"start"