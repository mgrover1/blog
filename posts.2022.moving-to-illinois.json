night trivia at Rayback, Friday Happy Hour at Jungle, and Saturday morning hikes around Boulder’s world-class trails.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"tL1nXUfj1M"}],"key":"iU9rmcPOqm"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"I look forward to visiting my Boulder friends in the future, and I am sure work will bring me to the Boulder at some point (looking forward to AMS 2023 in Denver).","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"Dd4nPjhk4l"}],"key":"KbCP1IT1FH"},{"type":"heading","depth":2,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Conclusions","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"hujXQ7Nj63"}],"identifier":"conclusions","label":"Conclusions","html_id":"conclusions","implicit":true,"key":"NPz40gD0Rk"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"It has been a fun filled, productive first few months at Argonne! I have already met up new friends and coworkers around the Argonne area, and look forward to exploring the Chicago area more!","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"Nh2y6WVt37"}],"key":"YkZNo23SE5"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Argonne’s softball league starts Wednesday, we already found a new Tuesday trivia place, and I have reconnected with some of my best friends from undergrad, who live a short drive away.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"LM5hyRRB2i"}],"key":"mimDW97CrQ"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"I am adjusting to my new home, and as with all things, it just takes time!","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"fbHP24Cvti"}],"key":"RmeSSJjoL8"}],"key":"QWaNZG1T8g"}],"key":"S1JQpocmXq"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Visualizing Hurricane Ian Using hvPlot","url":"/posts/2022/hurricane-ian-hvplot","group":"2022"},"next":{"title":"SciPy 2022 Reflection","url":"/posts/2022/scipy-takeaways","group":"2022"}}},"domain":"http://localhost:3000"}