e":"text","value":". That work deepened my conviction that open-source infrastructure is essential for advancing weather and climate science, and building a strong open science community around these tools.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"q80yPgV0WK"}],"key":"yoVIgdXP5x"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"So when the opportunity at Spire came along, it felt like a natural evolution, taking those same skills and tools to scaling data pipelines in industry, especially on cloud platforms such as Amazon Web Services (AWS).","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"t8SSS8bD81"}],"key":"XYWa0z8V9Y"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Why Spire","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"w64OpTatR6"}],"identifier":"why-spire","label":"Why Spire","html_id":"why-spire","implicit":true,"key":"PBJWbfrsOZ"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"link","url":"https://spire.com/","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Spire Global","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"OR75h31Paw"}],"urlSource":"https://spire.com/","key":"ozWT8LSd2k"},{"type":"text","value":" is a space-based data, analytics, and space services company. They operate a constellation of nanosatellites that collect global weather data through radio occultation, AIS (ship tracking), and ADS-B (aircraft tracking), among other payloads. For someone working at the intersection of weather data and software engineering, it’s a compelling environment. I also knew a few of the employees, based in Boulder Colorado, before making the leap. They all had great things to say, and an opportunity opened at the right time.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"TM5KBLH84x"}],"key":"OAnfoq2s24"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"What drew me in was the combination of:","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"BeWkuJY7RY"}],"key":"zF0NsPLO71"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Global-scale weather data","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"gOeeHiwzoj"}],"key":"QUtHJmI7Vx"}],"key":"ZSiE93DRo1"}],"key":"XXohUS9FUp"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"A commitment to supporting open-source (where applicable)","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"oj96GjyYbg"}],"key":"YZ7v8YgF7n"}],"key":"BH2oqWRESx"}],"key":"m45NtLWsiH"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Cloud-native infrastructure","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"tEL4DW6Q28"}],"key":"d0jKxjjB6S"}],"key":"NvU9vjVSWB"}],"key":"TbZdnYtXmQ"}],"key":"Rn49xRqVLW"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"My role focuses on building and deploying data pipelines that process numerical weather prediction and observations, making them available for downstream applications for our customers.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"FPxG8Z51ni"}],"key":"yzfjVndcXl"},{"type":"heading","depth":2,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"The Technical Work","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"lc7GBlRuA6"}],"identifier":"the-technical-work","label":"The Technical Work","html_id":"the-technical-work","implicit":true,"key":"IFtsjFDp3L"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"gribberish: Decoding Weather Data at Speed","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"WJ8kdUcsoH"}],"identifier":"gribberish-decoding-weather-data-at-speed","label":"gribberish: Decoding Weather Data at Speed","html_id":"gribberish-decoding-weather-data-at-speed","implicit":true,"key":"g5jmrbfIMM"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"One of the key tools in this space is ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"AhYFnFrXou"},{"type":"link","url":"https://github.com/mpiannucci/gribberish","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"gribberish","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"GZUdI4smEG"}],"urlSource":"https://github.com/mpiannucci/gribberish","error":true,"key":"WqteFmx4GO"},{"type":"text","value":", a Rust-based GRIB2 decoder with Python bindings. GRIB2 is the standard binary format for weather data, used by meteorological agencies worldwide. If you’ve worked with weather model output or observational datasets, you’ve almost certainly encountered it. It is structured to work well with operational writing, but it is not the optimal storage format for archives.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"NhiQdB3UkK"}],"key":"zKAsOI0cm2"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The challenge with GRIB2 is that decoding it at scale. Millions of messages per day from global models and satellite retrievals requires high throughput. Traditional Python-based decoders struggle at this volume. Gribberish solves this by doing the heavy lifting in Rust while exposing a clean Python API, giving you the performance of a systems language with the broader ecosystem support of Python.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"T2ECKKqVL4"}],"key":"uXTpX4ye8n"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"I’ve been contributing to gribberish to improve its support for the kinds of GRIB2 messages we encounter in satellite weather pipelines. Edge cases in packing schemes, template definitions, and metadata handling that matter when you’re processing data from diverse sources.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"GS6nOzF3IX"}],"key":"fe0yIItt3k"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Continuing Open-Source Commitments","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"md1yh3uJaL"}],"identifier":"continuing-open-source-commitments","label":"Continuing Open-Source Commitments","html_id":"continuing-open-source-commitments","implicit":true,"key":"t9U88HbMwY"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Moving to industry hasn’t changed my commitment to open-source work. I continue to maintain and contribute to:","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"msvjhGLOYN"}],"key":"hIPKkLnENe"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":49,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://github.com/ARM-DOE/pyart","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"strong","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Py-ART","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"CG2GLNo5Tz"}],"key":"RsSlYlWnX9"}],"urlSource":"https://github.com/ARM-DOE/pyart","error":true,"key":"WPJmyaQR7b"},{"type":"text","value":" — the Python ARM Radar Toolkit for weather radar processing","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"znAdvBQpyj"}],"key":"pZVLaNJqPX"}],"key":"MxfiAItpC3"},{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://github.com/openradar/xradar","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"strong","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"xradar","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"uVdic3Bzfs"}],"key":"ZUH9Ym0Nqq"}],"urlSource":"https://github.com/openradar/xradar","error":true,"key":"iNAhD1o22s"},{"type":"text","value":" — bringing weather radar data into the Xarray/Pangeo ecosystem","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"qjbQiT55v0"}],"key":"D4dmr9V9XH"}],"key":"Jm9frgiaRR"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The broader ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Oo0108AJFu"},{"type":"link","url":"https://pangeo.io/","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Pangeo community","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"L4Xqecp8ah"}],"key":"bO8ub1q8mf"}],"urlSource":"https://pangeo.io/","key":"JFCtQKwTE5"},{"type":"text","value":" — building tools and practices for scalable geoscience","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"tgSq13BPKB"}],"key":"vQhL9blYnk"}],"key":"w6IEwCHgs6"}],"key":"aQMEQnotev"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"I also continue co-chairing the AMS Committee on Environmental Information Processing Technologies and helping organize the Earth/Ocean/Geo/Atmospheric Science track at ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"ZYxrkfvYKe"},{"type":"link","url":"https://www.scipy2024.scipy.org/","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"SciPy","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"K33IrdaRWH"}],"urlSource":"https://www.scipy2024.scipy.org/","key":"a5JJa5u7lA"},{"type":"text","value":".","position":{"start":{"line"