":"KOwnWBLArk"}],"key":"g0AmmXX20y"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Blog","url":"/blog","group":"Welcome"},"next":{"title":"SciPy 2025 🐍","url":"/posts/2025/scipy-2025-takeaways","group":"2025"}}},"domain":"http://localhost:3000"}